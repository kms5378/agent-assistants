APP_NAME=personal-ai-assistant
APP_ENV=development
APP_BASE_URL=https://your-domain.example.com
DATABASE_URL=postgresql+psycopg://assistant:assistant@postgres:5432/assistant
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.4-mini
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=replace-with-random-secret
TELEGRAM_WEBHOOK_KEY=replace-with-random-path-key
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=https://your-domain.example.com/auth/google/callback
GOOGLE_OAUTH_SCOPES=openid email profile https://www.googleapis.com/auth/calendar.events
DEFAULT_TIMEZONE=Asia/Seoul
APP_ENCRYPTION_KEY=replace-with-long-random-string
WORKER_POLL_SECONDS=5
REMINDER_BATCH_SIZE=20
